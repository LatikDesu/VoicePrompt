local Document = require("../plugin/voice-prompt/lib/document.luau")
local state = Document.new("s1")
state = Document.reduce(state, { kind = "final", text = "Не удаляй 42 файла" })
local original = state.raw
local generation = state.input_generation
local requested, snapshot = Document.begin_request(state, "r1", "clean", 0)
local edited = Document.reduce(requested, { kind = "edit", text = "Не удаляй 43 файла" })
edited = Document.reduce(edited, { kind = "edit", text = "Не удаляй 42 файла" })
assert(edited.input_generation == generation)
assert(edited.document_version == snapshot.document_version + 2)
local received, disposition = Document.receive_result(edited, snapshot, "Не удаляй 42 файла.", 1)
assert(disposition == "proposal")
assert(received.current == "Не удаляй 42 файла")
assert(received.proposal.text == "Не удаляй 42 файла.")
local applied = Document.reduce(received, { kind = "apply_proposal" })
assert(applied.current == "Не удаляй 42 файла.")
assert(applied.raw == original)
local undone = Document.reduce(applied, { kind = "undo" })
assert(undone.current == "Не удаляй 42 файла")
local cleared = Document.reduce(undone, { kind = "clear" })
assert(cleared.current == "" and cleared.raw == original)
assert(Document.reduce(cleared, { kind = "undo" }).current == "Не удаляй 42 файла")
local deleted = Document.reduce(edited, { kind = "delete" })
local after, dropped = Document.receive_result(deleted, snapshot, "late text", 2)
assert(dropped == "discarded" and after.current == "" and after.raw == nil)
local bounded = Document.reduce(Document.new("bounded"), { kind = "final", text = "original" })
for index = 1, 12 do bounded = Document.reduce(bounded, { kind = "replace", text = tostring(index) }) end
assert(#bounded.undo == 10 and bounded.raw == "original")
assert(Document.reduce(bounded, { kind = "restore" }).current == "original")
local accepted = pcall(Document.reduce, bounded, { kind = "edit", text = string.rep("я", 32769) })
assert(not accepted and bounded.current == "12")
local pending, expiredSnapshot = Document.begin_request(bounded, "expired", "clean", 0)
local expired, expiration = Document.receive_result(pending, expiredSnapshot, "overwrite", expiredSnapshot.deadline)
assert(expiration == "discarded" and expired.current == "12")
local fresh, oldSnapshot = Document.begin_request(bounded, "old", "clean", 0)
fresh = Document.begin_request(fresh, "new", "prompt", 1)
local unchanged, stale = Document.receive_result(fresh, oldSnapshot, "overwrite", 2)
assert(stale == "discarded" and unchanged.current == "12" and unchanged.request.token == "new")
return true
